# Copy to docker/.env for local dev. NEVER commit docker/.env with real secrets.
#   copy docker\.env.example docker\.env   (Windows)
#   cp docker/.env.example docker/.env     (Linux/macOS)
# Production: inject these via CI/CD env, user secrets, or Docker secrets —
# never bake them into images or compose files.

POSTGRES_USER=objectstorage
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=objectstorage
POSTGRES_PORT=5432

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-min-8-chars
MINIO_BUCKET=objectstorage
MINIO_S3_PORT=9000
MINIO_CONSOLE_PORT=9001

API_PORT=8080
