{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    // Overridden in docker via ConnectionStrings__Postgres. Real secrets come from env/user-secrets, never source control.
    "Postgres": "Host=localhost;Port=5432;Database=objectstorage;Username=objectstorage;Password=objectstorage-dev-only"
  },
  "MinIO": {
    // Overridden in docker via MinIO__* env vars. Typed options class lands in Phase 3.
    "Endpoint": "localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin-dev-only",
    "Bucket": "objectstorage",
    "UseSSL": false
  },
  "Storage": {
    "DefaultService": "objectstorage",
    "AllowedCategories": ["documents", "images", "invoices", "backups"],
    "MaxFileSizeBytes": 104857600,
    "AllowedContentTypes": ["application/pdf", "image/png", "image/jpeg", "text/plain", "application/octet-stream"],
    "MaxPresignedUrlExpirationSeconds": 604800
  },
  "Auth": {
    "HeaderName": "X-Api-Key",
    "SkipInDevelopment": true
  },
  "OpenTelemetry": {
    "Enabled": true,
    "ServiceName": "ObjectStorage.Api",
    "OtlpEndpoint": null,
    "ConsoleExporter": true
  }
}
